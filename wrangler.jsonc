// Cloudflare Workers configuration.
// The site is static: `npm run build` writes it to ./dist and Cloudflare serves
// those files. The "previews" block lets non-main branches deploy as previews.
{
  "name": "transmission-line-builder",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
